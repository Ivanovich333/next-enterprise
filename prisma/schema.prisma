// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = env("DATABASE_PROVIDER") // "sqlite" или "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Portfolio {
  id          String   @id @default(cuid())
  title       String
  description String?
  image       String
  category    String   // "apartment", "house", "office"
  location    String?
  area        String?  // площадь объекта
  year        Int?
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  name      String
  project   String
  rating    Int      @default(5)
  text      String
  avatar    String   @default("👤")
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  logo      String?
  fallback  String   @default("🏠")
  url       String?
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Package {
  id          String   @id @default(cuid())
  name        String
  price       String
  popular     Boolean  @default(false)
  features    String   // JSON array of features
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactRequest {
  id          String   @id @default(cuid())
  name        String
  phone       String
  email       String?
  message     String?
  source      String?  // откуда пришел запрос
  status      String   @default("new") // new, contacted, completed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
