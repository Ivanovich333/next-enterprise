# Environment Variables Example
# Copy this file to .env or .env.local and fill in your values

# ============================================
# DATABASE CONFIGURATION
# ============================================

# Database provider: "sqlite" for local development, "postgresql" for production
DATABASE_PROVIDER="sqlite"

# Database URL
# Local (SQLite): file:./dev.db
# Production (PostgreSQL): postgresql://user:password@host:5432/dbname?schema=public
DATABASE_URL="file:./dev.db"

# ============================================
# AUTHENTICATION
# ============================================

# NextAuth secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-secret-key-change-this-in-production"

# NextAuth URL (your site URL)
# Local: http://localhost:3000
# Production: https://your-domain.com
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# TELEGRAM INTEGRATION
# ============================================

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=""

# Telegram Chat ID (get from @userinfobot)
TELEGRAM_CHAT_ID=""

# ============================================
# REQUIRED FOR PRODUCTION
# ============================================

# Site URL (используется для Open Graph, canonical URLs, etc.)
# Example: https://smarthome.uz or https://your-domain.com
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ============================================
# ANALYTICS (Optional but recommended)
# ============================================

# Yandex.Metrika ID
# Get from: https://metrika.yandex.ru
# Example: 12345678
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Google Analytics Measurement ID (optional)
# Get from: https://analytics.google.com
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ============================================
# EMAIL SERVICE (Required for forms to work)
# ============================================

# SendGrid API Key (if using SendGrid)
# Get from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=

# Or other email service
# MAILGUN_API_KEY=
# RESEND_API_KEY=

# Email to receive form submissions
EMAIL_TO=info@yourdomain.com

# Email "from" address
EMAIL_FROM=noreply@yourdomain.com

# ============================================
# OPTIONAL
# ============================================

# Bundle Analyzer (only for development)
# Set to "true" to analyze bundle size
ANALYZE=false

# Sentry DSN (for error tracking)
# Get from: https://sentry.io
# NEXT_PUBLIC_SENTRY_DSN=

# reCAPTCHA Site Key (for spam protection)
# Get from: https://www.google.com/recaptcha/admin
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=

# ============================================
# SOCIAL MEDIA (Update in code as well)
# ============================================

# These should be updated in app/contacts/page.tsx
# NEXT_PUBLIC_TELEGRAM_URL=https://t.me/yourusername
# NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/998901234567
# NEXT_PUBLIC_VK_URL=https://vk.com/yourpage

# ============================================
# NOTES
# ============================================

# 1. Never commit .env files to Git!
# 2. Use .env.local for local development
# 3. Add environment variables in your hosting platform:
#    - Vercel: Settings → Environment Variables
#    - Netlify: Site settings → Environment variables
#    - Railway: Variables tab
# 4. Variables starting with NEXT_PUBLIC_ are exposed to the browser
# 5. Other variables are only available on the server
